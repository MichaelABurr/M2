# @configure_input@
include ../../../include/config.Makefile
VPATH = @srcdir@
SRCDIR = @srcdir@
DEPENDS = yes
include ../Makefile.common
include ../Makefile.files
include @srcdir@/Makefile.files
export LD_LIBRARY_PATH := $(BUILTLIBPATH)/lib:$(LD_LIBRARY_PATH)

CPPFLAGS := -I. -I@srcdir@  -I@srcdir@/..  $(CPPFLAGS) \
     -isystem $(GTEST_DIR) -isystem $(GTEST_DIR)/include
CXXFLAGS += -std=gnu++17 -Wno-sign-conversion

LOADLIBES += @BUILTLIBS@ @LINALGLIBS@ @LIBS@ @FCLIBS@ -lgtest -pthread @OPENMP_CXXFLAGS@ @OPENMP_LIBS@

.PHONY: runtests

all: $(UNITTEST_OBJECT_FILES) $(LIBENGINE)

check: runtests

fullCheck: $(UNITTEST_TARGET)
	valgrind --track-origins=yes ./$(UNITTEST_TARGET)

$(UNITTEST_TARGET) : $(UNITTEST_OBJECT_FILES) $(LIBENGINE)
	@CXX@ $(LDFLAGS) $^ $(LOADLIBES) -o $@

GTEST_FILTER = *

runtests: $(UNITTEST_TARGET)
	time ./$(UNITTEST_TARGET) --gtest_filter="$(GTEST_FILTER)"

MORE_OPTIONS = -Wno-cast-qual
COMPILE.cc += $(MORE_OPTIONS)

Makefile: Makefile.in; cd ../../..; ./config.status Macaulay2/e/unit-tests/Makefile
# The source stems include subdirectories; create them even with DEPENDS=no.
.PHONY: unit-test-directories
$(UNITTEST_OBJECT_FILES): | unit-test-directories
unit-test-directories:
	$(MKDIR_P) $(sort $(dir $(UNITTEST_OBJECT_FILES)))

clean::
	rm -f $(UNITTEST_OBJECT_FILES) $(UNITTEST_CCFILES:=.dep) \
	  $(UNITTEST_CCFILES:=.rpo) *.o *.rpo *.dep dep-*.tmp LOGFILE $(UNITTEST_TARGET)
distclean: clean; rm -f Makefile

ifeq "$(DEPENDS)" "yes"
include $(UNITTEST_CCFILES:=.dep)
endif

# Local Variables:
# compile-command: "make -C $M2BUILDDIR/Macaulay2/e/unit-tests check"
# End:
